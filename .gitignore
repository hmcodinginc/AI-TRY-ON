# -------------------------------------------------------------------
# DEPENDENCIES
# -------------------------------------------------------------------
node_modules/
package-lock.json
yarn.lock
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# -------------------------------------------------------------------
# SECRETS & CREDENTIALS (CRITICAL)
# -------------------------------------------------------------------
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.pem
*.key
# (Do NOT ignore .env.example, teammates need it for reference!)

# -------------------------------------------------------------------
# BUILD & PRODUCTION OUTPUTS
# -------------------------------------------------------------------
dist/
build/
out/
.next/

# -------------------------------------------------------------------
# STORAGE & DYNAMIC UPLOADS
# -------------------------------------------------------------------
# Ignore user uploads but KEEP the seed product catalog images
storage/uploads/*
storage/temp/*
!storage/uploads/.gitkeep
!storage/temp/.gitkeep

# -------------------------------------------------------------------
# OS & EDITOR FILES
# -------------------------------------------------------------------
.DS_Store
Thumbs.db
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

storage/temp_*.jpg
storage/tryon-results/*
storage/outfit-previews/*
!storage/outfit-previews/.gitkeep
!storage/tryon-results/.gitkeep
