# AI Try-On Server — Environment Variables
# Copy this file to .env and fill in your values

PORT=6001
MONGO_URI=mongodb://127.0.0.1:27017/ai_tryon_db
MERCHANT_API_URL=http://localhost:5000

# ─────────────────────────────────────────
# TRY-ON PROVIDER
# ─────────────────────────────────────────
# "demo"        → No API key needed. Uses deterministic product images (for development/testing).
# "pixel"       → Uses PixelAPI for real AI virtual try-on. Requires PIXEL_API_KEY below.
# "huggingface" → IDM-VTON on Hugging Face (person + garment). Requires HF_TOKEN below.
TRYON_PROVIDER=demo

# Hugging Face (only needed when TRYON_PROVIDER=huggingface or tryoffdiff)
# Create a token at https://huggingface.co/settings/tokens
HF_TOKEN=
HF_VTON_SPACE=yisol/IDM-VTON

# ─────────────────────────────────────────
# PIXELAPI (only needed when TRYON_PROVIDER=pixel)
# ─────────────────────────────────────────
# Get your key at: https://pixelapi.ai
# IMPORTANT: Never expose this key in frontend code, Git, or public files.
PIXEL_API_KEY=your_pixel_api_key_here
PIXEL_API_BASE_URL=https://api.pixelapi.dev/v1
